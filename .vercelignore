# Local evidence, tracker databases, credentials, and build caches never ship.
artifacts/
.beads/
.ntm/
.claude/
.wrangler/
.git/
.vercel/
.next*/
node_modules/
.env*
*.pem
*.log
*.tsbuildinfo
daemon.lock
target/
test-results/
playwright-report/
blob-report/
coverage/
tmp/
