  "notation": "modern-pedagogical",
  "unitSystem": "si",
  "live": false,
  "assumptions": [
    "The n steps are independent, each with mean zero and the same mean square l squared.",
    "These are modern teaching equations in SI notation, not a transcription of the printed paper."
