  "notation": "modern-pedagogical",
  "unitSystem": "si",
  "live": false,
  "assumptions": [
    "Jumps in successive intervals are independent, and the jump density phi is the same at every place and every time.",
    "These are modern teaching equations in SI notation, not a transcription of the printed paper."
  ],
