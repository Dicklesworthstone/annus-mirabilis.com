  "notation": "modern-pedagogical",
  "unitSystem": "si",
  "live": false,
  "assumptions": [
    "Jumps small compared with the distance over which the density changes, so terms beyond Delta squared are dropped.",
    "These are modern teaching equations in SI notation, not a transcription of the printed paper."
  ],
