  "notes": [
    {
      "nodeId": "eq-model-fd-vector-length.op.relation",
      "title": "What it asserts",
      "explanation": "The arrow's length can be computed from any pair of perpendicular components, so turning the axes leaves it unchanged.",
      "foundation": "vectors-components"
    },
    {
      "nodeId": "eq-model-fd-vector-length.op.root",
      "title": "The square root",
      "explanation": "Undoes the squaring, so the result is a speed and not a squared speed.",
      "foundation": "vectors-components"
    },
    {
      "nodeId": "eq-model-fd-vector-length.op.sum",
      "title": "The two squares added",
      "explanation": "The squares of the sides of a right triangle add to the square of its long side.",
      "foundation": "vectors-components"
    },
    {
      "nodeId": "eq-model-fd-vector-length.op.squareX",
      "title": "v_x squared",
      "explanation": "Squaring makes the sign of the component irrelevant.",
      "foundation": "vectors-components"
    },
    {
      "nodeId": "eq-model-fd-vector-length.op.squareY",
      "title": "v_y squared",
      "explanation": "The same for the component across x.",
      "foundation": "vectors-components"
    },
    {
      "nodeId": "eq-model-fd-vector-length.t.length",
      "title": "|v|, the speed",
      "explanation": "The length of the velocity arrow.",
      "foundation": "vectors-components"
    },
