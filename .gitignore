# Next.js and build output
.next*
out/
/build/
dist/

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem

# Vercel (the verified prebuilt workflow writes .vercel/output locally)
.vercel

# Logs and tool caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lockb
.turbo
*.tsbuildinfo

# OS
.DS_Store
._*
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Rust build intermediates for any local WASM staging crate.
# Content-addressed WASM artifacts that ship are committed under public/wasm/.
target/

# Test, audit, and retained-failure evidence (kept locally or attached to CI runs, never committed)
artifacts/
test-results/
playwright-report/
blob-report/
/coverage/

# Retained non-published sources (local-only pins and parent scans; am-src-download-script-15ar).
# Local-only pins and parent scans in sources/ are permanent local artifacts and never deleted.
/sources/


# Scratch work belongs in a session scratch directory, never in the repository
tmp
tmp/
*.wip.txt
out.txt

# Agent tooling runtime state
daemon.lock
*.lock
.ntm/
.doctor/
.beads/*.db
.beads/*.db-journal
.beads/*.db-wal
.beads/*.db-shm
.beads/*.sock*
.beads/.local_version
.beads/recovery_*

# The legacy Pages Router is forbidden (AGENTS.md Rule 2). Ignoring the path keeps an
# accidental directory out of commits; the architecture test still fails the build if it exists.
src/pages/

# Cloudflare Wrangler local state (created by CLI runs; never committed)
.wrangler/

# Claude Code session runtime state. Ignoring the directory (not just the lock
# file) keeps it out of the architecture gate's root-file allowlist scan.
.claude/

# Build-time laboratory results and source digests; regenerated before dev/build/test
src/generated/

# Versioned reading payloads and public machine-readable exports
generated/
public/edition/
.env*

# iPhone app (App plan §4). Xcode output lives OUTSIDE the repository
# (scripts/app/xcode.ts); these two lines only stop a stray build from being
# committed. Also Xcode user state and signing material, which never enter it.
ios/build/
DerivedData/
*.xcuserstate
xcuserdata/
*.p8
*.p12
*.cer
*.mobileprovision
*.ipa
